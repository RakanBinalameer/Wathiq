SECRET_KEY=change-me-long-random-string      # python -c "import secrets;print(secrets.token_hex(32))"
DEMO_PASSWORD=                               # optional; if empty a random one is printed once on first run
FORCE_HTTPS=1                                # set to 1 behind TLS (enables HSTS + Secure cookies)
# WHISPER_SIZE=small                         # tiny | base | small; model files via: python scripts/get_whisper.py small
# WHISPER_MODEL_DIR=                         # optional explicit folder
# WHISPER_THREADS=2
# GEMINI_API_KEY=                            # optional cloud engine (Gemini 3.5 Transcribe): the AUDIO LEAVES the server. Never commit a real key.
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# STT_ENGINE=auto                            # local = ignore the key and use only the local model
